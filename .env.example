# Copiar este archivo a .env y completar los valores.
# El .env NO se versiona (ver .gitignore y docs/guias/seguridad-y-datos.md).

# --- PostgreSQL (instalado localmente en Windows, sin Docker) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# Contraseña que pusiste al instalar PostgreSQL. Dejarla vacía acá: se completa solo en .env.
POSTGRES_PASSWORD=
# Base de desarrollo y base de tests. Las crea `pnpm db:crear`.
POSTGRES_DB=gestion
POSTGRES_DB_TEST=gestion_test
# true solo en producción, si el servidor de base exige TLS.
POSTGRES_SSL=false

# --- Autenticación ---
# Clave con la que Better Auth firma y cifra. Mínimo 32 caracteres.
# Generar una propia y NO reutilizarla entre desarrollo y producción:
#   PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
#   Linux:      openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de la API y de la web.
BETTER_AUTH_URL=http://localhost:3001
URL_WEB=http://localhost:3000

# --- Correo saliente (SMTP) ---
# Opcional. Sin esto la API arranca igual y escribe los correos de verificación
# en el log, para poder probar el flujo en desarrollo sin servidor de correo.
# En producción hay que configurarlo o nadie va a poder confirmar su cuenta.
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_PASSWORD=
# De quién dice venir el correo. Por ejemplo: Gestión <no-responder@midominio.com>
SMTP_REMITENTE=

# --- Primer admin (script `pnpm usuario:admin`) ---
# La contraseña NO va acá: el script la pide por consola al momento de crear la
# cuenta, así no queda guardada en ningún archivo. Ningún endpoint permite
# volverse admin.
ADMIN_USUARIO=iotero
ADMIN_NOMBRE=Ignacio
ADMIN_APELLIDO=Otero
ADMIN_EMAIL=nacho.ote@gmail.com

# --- API ---
NODE_ENV=development
PORT=3001
# error | warn | info | debug
LOG_LEVEL=debug
# Orígenes permitidos por CORS, separados por coma. Nunca "*".
ORIGENES_PERMITIDOS=http://localhost:3000

# --- Web ---
# Dónde vive la API. Las NEXT_PUBLIC_* quedan visibles en el navegador:
# nunca poner un secreto acá.
NEXT_PUBLIC_URL_API=http://localhost:3001
