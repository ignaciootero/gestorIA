# Copiar este archivo a .env y completar los valores.
# El .env NO se versiona (ver .gitignore y docs/guias/seguridad-y-datos.md).

# --- PostgreSQL (instalado localmente en Windows, sin Docker) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# Contraseña que pusiste al instalar PostgreSQL. Dejarla vacía acá: se completa solo en .env.
POSTGRES_PASSWORD=
# Base de desarrollo y base de tests. Las crea `pnpm db:crear`.
POSTGRES_DB=gestion
POSTGRES_DB_TEST=gestion_test
# true solo en producción, si el servidor de base exige TLS.
POSTGRES_SSL=false

# --- API ---
NODE_ENV=development
PORT=3001
# error | warn | info | debug
LOG_LEVEL=debug
# Orígenes permitidos por CORS, separados por coma. Nunca "*".
ORIGENES_PERMITIDOS=http://localhost:3000
