{
  "name": "@gestoria/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "generar": "drizzle-kit generate",
    "migrar": "node --env-file-if-exists=../../.env src/migrar.ts",
    "migrar:test": "node --env-file-if-exists=../../.env src/migrar.ts --test",
    "crear-bases": "node --env-file-if-exists=../../.env src/crear-bases.ts"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gestoria/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
